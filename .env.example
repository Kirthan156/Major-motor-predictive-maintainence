# Copy to .env (same folder) and edit. .env is in .gitignore, so tokens never get pushed.

# MQTT broker the ESP32 publishes to (Mosquitto on this PC -> localhost)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=motor/sensors
# Only if your broker needs a login
MQTT_USER=
MQTT_PASSWORD=

# Dashboard (dashboard/server.py)
# Source: sim = demo motor (recorded data + injectable faults), mqtt = real ESP32, replay = a recording
DASHBOARD_SOURCE=sim
# For replay: a .jsonl file or a folder of them
DASHBOARD_REPLAY=
# auto = best model in models/ (anomaly_iforest > newest anomaly_* > anomaly_baseline). Or a path:
#   ../models/anomaly_baseline.joblib   or a plugin   ../models/anomaly_autoencoder.py
DASHBOARD_MODEL=auto
# Optional fault classifier, e.g. ../models/fault_rf.joblib (leave empty for none)
DASHBOARD_CLASSIFIER=
# Leave empty to use the threshold stored in the model
DASHBOARD_THRESHOLD=
# Change-since-baseline detector
DASHBOARD_CHANGE_THRESHOLD=6.0
DASHBOARD_LEARN=30
DASHBOARD_PORT=8000

# InfluxDB (only for pm/recorder.py; skip with --no-influx)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=paste-a-new-token-here
INFLUX_ORG=majorproj
INFLUX_BUCKET=majorproj
